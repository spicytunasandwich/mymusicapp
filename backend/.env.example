PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audira_db

# Security & Tokens
JWT_SECRET=super_secret_jwt_key_audira_music_2026_change_in_prod
JWT_EXPIRES_IN=7d
EMAIL_VERIFY_SECRET=email_verify_secret_key_audira
RESET_PASSWORD_SECRET=reset_password_secret_key_audira

# Google OAuth (for Step 2)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SMTP / Email (for verification & password reset)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM=Audira Music <noreply@audiramusic.com>

# Spotify Web API (for Step 6)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
